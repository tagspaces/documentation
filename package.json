{
  "name": "tagspaces",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3001",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "serve": "docusaurus serve",
    "gen-pdf-bak": "npx docusaurus-pdf from-build-config",
    "gen-pdf": "npx docs-to-pdf --initialDocURLs='http://localhost:3000/' --contentSelector='article' --paginationSelector='a.pagination-nav__link.pagination-nav__link--next' --excludeSelectors='.margin-vert--xl a,[class^='tocCollapsible'],.breadcrumbs,.theme-edit-this-page' --coverImage='http://localhost:3000/img/logo.svg' --coverTitle='TagSpaces v6 - User Documentation'",
    "update-ext": "./update-external.sh",
    "anigif": "gifify --colors 150 --to 19 media/input.webm -o media/result.gif",
    "prepare1": "yarn optipng && yarn update-ext && yarn build",
    "optipng": "optipng media/*png",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "toavif": "magick mogrify -format avif -quality 95 -type truecolor -alpha on"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/plugin-client-redirects": "3.10.1",
    "@docusaurus/plugin-pwa": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mdx-js/react": "3.1.1",
    "@mui/icons-material": "7.3.10",
    "@mui/material": "7.3.10",
    "clsx": "2.1.1",
    "docusaurus-lunr-search": "^3.6.0",
    "docusaurus-pdf": "1.2.0",
    "docusaurus-plugin-llms": "0.3.0",
    "mr-pdf": "1.1.0",
    "prism-react-renderer": "2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-material-ui-carousel": "3.4.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/types": "3.9.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
